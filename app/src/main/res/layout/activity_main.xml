<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <!-- 修正点1: IDを 'nfc_id_text' に変更 -->
    <TextView
        android:id="@+id/nfc_id_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NFCをかざしてください"
        android:textSize="18sp"/>

    <!-- このボタンは現在使われていないようですが、IDはそのままにしておきます -->
    <Button
        android:id="@+id/btnAddSteps"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="歩数追加（1万歩）" />

    <!-- このボタンも現在使われていないようですが、IDはそのままにしておきます -->
    <Button
        android:id="@+id/btnAddStamp"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="スタンプ取得"
        android:layout_marginTop="16dp" />

    <!-- 修正点2: IDを 'confirmPointsButton' に変更 -->
    <Button
        android:id="@+id/confirmPointsButton"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="ポイント確認"
        android:layout_marginTop="16dp" />

</LinearLayout>
